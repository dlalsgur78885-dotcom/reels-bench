{
  "appId": "com.reels-studio.app",
  "productName": "Reels Studio",
  "asar": true,
  "asarUnpack": [
    "node_modules/ffmpeg-static/**/*",
    "node_modules/@ffprobe-installer/**/*"
  ],
  "files": [
    "out/**/*",
    "package.json",
    "!**/*.map"
  ],
  "directories": {
    "output": "release"
  },
  "win": {
    "target": ["nsis"]
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.video"
  },
  "linux": {
    "target": ["AppImage"]
  }
}
