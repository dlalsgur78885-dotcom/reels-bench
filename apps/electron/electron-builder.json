{
  "appId": "com.reelsbench.reelsstudio",
  "productName": "Reels Studio",
  "asar": true,
  "asarUnpack": [
    "node_modules/ffmpeg-static/**/*",
    "node_modules/@ffprobe-installer/**/*",
    "node_modules/sharp/**/*",
    "node_modules/@img/**/*"
  ],
  "files": [
    "out/**/*",
    "package.json",
    "!**/*.map"
  ],
  "extraResources": [
    {
      "from": "build/fonts",
      "to": "build/fonts",
      "filter": ["**/*.otf", "**/*.ttf"]
    },
    {
      "from": "resources/whisper/win32-x64",
      "to": "whisper/win32-x64"
    }
  ],
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "icon": "build/icon.ico",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Reels Studio"
  },
  "publish": {
    "provider": "generic",
    "url": "https://mrpbovbxtablvawszhey.supabase.co/storage/v1/object/public/electron-releases/win",
    "channel": "latest"
  }
}
