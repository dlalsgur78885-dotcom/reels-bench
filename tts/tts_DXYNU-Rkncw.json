{
  "tts_script": [
    {
      "start": "0",
      "end": "3.4",
      "direction": "차분하게 말한다",
      "text": "돈 벌겠다고 결심한 지 한 달 만에 1650만원 벌었던 썰"
    },
    {
      "start": "3.4",
      "end": "4.6",
      "direction": "자신있게 말한다",
      "text": "일단 인증부터 하고 가겠습니다."
    },
    {
      "start": "4.9",
      "end": "6.6",
      "direction": "진지하게 강조한다",
      "text": "그리고 이 시리즈의 가장 중요한 점은"
    },
    {
      "start": "6.6",
      "end": "9.8",
      "direction": "분명하게 해명한다",
      "text": "뭐 여러분께 월천버는 방법을 알려드리는 영상이 절대 아니고"
    },
    {
      "start": "9.8",
      "end": "11.9",
      "direction": "차분하게 회상한다",
      "text": "그냥 그 다사다단했던 30일간의 경험을"
    },
    {
      "start": "11.9",
      "end": "15.0",
      "direction": "솔직하게 고백한다",
      "text": "이제는 정말 솔직하게 얘기할 수 있게 되어서 만드는 영상입니다."
    },
    {
      "start": "15.2",
      "end": "17.2",
      "direction": "차분하게 설명한다",
      "text": "이 모든 과정을 간단하게 요약하자면"
    },
    {
      "start": "17.2",
      "end": "20.1",
      "direction": "또박또박 말한다",
      "text": "저는 작년 4월부터 5월까지 여러분이 보고 계시는 이 계정 말고"
    },
    {
      "start": "20.1",
      "end": "22.8",
      "direction": "자랑스럽게 이어간다",
      "text": "이밀 계정을 하나 만들어서 팔로우 1만 명을 달성하고"
    },
    {
      "start": "22.8",
      "end": "24.6",
      "direction": "힘주어 강조한다",
      "text": "정확하게 1650만원을 벌었습니다."
    },
    {
      "start": "24.9",
      "end": "28.3",
      "direction": "진솔하게 털어놓는다",
      "text": "저도 사실 살면서 그렇게 큰 돈을 한 번에 벌어본다는 게 정말 처음이었고"
    },
    {
      "start": "28.3",
      "end": "31.6",
      "direction": "신기해하며 말한다",
      "text": "아직도 그때 그 한 달 동안 벌어진 일들이 믿기지 않을 정도로 신기합니다."
    },
    {
      "start": "31.7",
      "end": "36.0",
      "direction": "활기차게 선언한다",
      "text": "그럼 이제 긴말 말고 그 2025년 4월에 벌어졌던 이야기들을 본격적으로 시작해보도록 하겠습니다."
    },
    {
      "start": "36.1",
      "end": "38.2",
      "direction": "흥미롭게 시작한다",
      "text": "때는 바야흐로 2025년 3월?"
    },
    {
      "start": "38.4",
      "end": "41.4",
      "direction": "의미심장하게 말한다",
      "text": "제가 그때 제 인생을 바꿀 만한 큰 결심을 하나 하거든요."
    },
    {
      "start": "41.6",
      "end": "44.5",
      "direction": "가볍게 예고한다",
      "text": "그 결심에 대해서 제가 다음 영상에서 제대로 한번 다뤄볼게요."
    }
  ]
}