{
  "tts_script": [
    {
      "start": "0",
      "end": "6.8",
      "direction": "호기심을 유발하며",
      "text": "집 나온 29알바생인데 기업가치 3천억 그런 천재 사업가들의 처음은 어떤 모습이었는지 궁금하지 않으신가요?"
    },
    {
      "start": "6.9",
      "end": "11.2",
      "direction": "담담하게",
      "text": "저는 27살 남들이 취업할 나이에 제주도로 내려와 설거지 알보부터 시작했습니다."
    },
    {
      "start": "11.4",
      "end": "15.8",
      "direction": "진지하게",
      "text": "현재는 29이고 설거지 시간을 제외한 모든 시간을 사업을 공부하는 데 시간을 썼습니다."
    },
    {
      "start": "16.0",
      "end": "20.5",
      "direction": "자신감 있게",
      "text": "공부했던 내용을 가장 먼저 알바 중에 호텔 1층 와인바에 적응해 매출 3배로 올렸고"
    },
    {
      "start": "20.5",
      "end": "24.4",
      "direction": "활기차게",
      "text": "책을 추천해주는 와인바 컨셉으로 매달 서울 망원에서 파업을 진행하고 있습니다."
    },
    {
      "start": "24.4",
      "end": "29.8",
      "direction": "힘주어 강조하며",
      "text": "1호 호텔 대표님께 인정받아 호텔 리브랜딩 책임기획자가 되어 지난달에 9천만원의 매출을 만들어냈습니다."
    },
    {
      "start": "30",
      "end": "32.2",
      "direction": "경쾌하게",
      "text": "또 마케팅 공부를 통해 인스타 6천명을 이루었습니다."
    },
    {
      "start": "32.5",
      "end": "34.2",
      "direction": "차분하게",
      "text": "저는 이렇게 처음을 시작했습니다."
    },
    {
      "start": "34.5",
      "end": "36.3",
      "direction": "확신에 차서",
      "text": "그리고 세계적인 사업가가 될 예정입니다."
    },
    {
      "start": "36.5",
      "end": "40.6",
      "direction": "덤덤하고 여유롭게",
      "text": "이렇게 말하면 사람들은 또 끌어당긴 법칙한다고 나대는 애송이로 보실 수도 있습니다."
    },
    {
      "start": "40.8",
      "end": "41.9",
      "direction": "단호하게",
      "text": "하지만 저는 자신 있습니다."
    },
    {
      "start": "42.2",
      "end": "44.5",
      "direction": "설득력 있게",
      "text": "속는 셈치고 팔로우하시는 저를 지켜봐주세요."
    },
    {
      "start": "44.7",
      "end": "47.1",
      "direction": "신뢰감 주는 목소리로",
      "text": "이미 1년 동안 모든 과정을 일세에 공유하고 있습니다."
    },
    {
      "start": "47.4",
      "end": "49.3",
      "direction": "쿨하고 당당하게",
      "text": "가능성이 안 보인다면 취소하셔도 좋습니다."
    },
    {
      "start": "49.5",
      "end": "50.3",
      "direction": "힘주어 단호하게",
      "text": "저는 장담합니다."
    },
    {
      "start": "50.3",
      "end": "54.3",
      "direction": "열정적이고 확신에 차서",
      "text": "여러분들은 몇 년 후 세계적인 사업가의 초창기 팔로우가 되실 수 있습니다."
    },
    {
      "start": "54.4",
      "end": "55.2",
      "direction": "크고 활기차게",
      "text": "안설 화이팅!"
    }
  ]
}