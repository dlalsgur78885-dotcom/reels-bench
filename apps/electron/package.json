{
  "name": "reels-studio-electron",
  "productName": "Reels Studio",
  "version": "0.2.40",
  "private": true,
  "description": "Short-form video editor for Reels Bench",
  "author": {
    "name": "Reels Bench"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder --win --x64",
    "package:portable": "npm run build && electron-builder --win portable --x64",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "publish": "node scripts/publish-github.mjs"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@supabase/supabase-js": "^2.106.0",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.34.5",
    "tree-kill": "^1.2.2",
    "ulid": "^3.0.2",
    "zundo": "^2.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^32.2.7",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
