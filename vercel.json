{
  "version": 2,
  "regions": ["icn1"],
  "buildCommand": "echo cb-2026-05-27-31 && cd web && rm -rf dist node_modules/.vite && npm install && npm run build",
  "builds": [
    { "src": "web/dist/mockup-catalog/**", "use": "@vercel/static" },
    { "src": "web/dist/mockup-devices/**", "use": "@vercel/static" },
    { "src": "web/dist/mockup-cards/**", "use": "@vercel/static" },
    { "src": "web/dist/mockup-bg-thumbs/**", "use": "@vercel/static" },
    { "src": "web/dist/mockup-frames/**", "use": "@vercel/static" },
    { "src": "api/index.py", "use": "@vercel/python", "config": { "maxDuration": 800, "includeFiles": "web/dist/**" } },
    { "src": "api/cron/fb-scrape.ts", "use": "@vercel/node", "config": { "maxDuration": 60 } }
  ],
  "routes": [
    { "src": "/mockup-catalog/(.*)", "dest": "/web/dist/mockup-catalog/$1",
      "headers": { "Cache-Control": "public, max-age=3600" } },
    { "src": "/mockup-devices/(.*)", "dest": "/web/dist/mockup-devices/$1",
      "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/mockup-cards/(.*)", "dest": "/web/dist/mockup-cards/$1",
      "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/mockup-bg-thumbs/(.*)", "dest": "/web/dist/mockup-bg-thumbs/$1",
      "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/mockup-frames/(.*)", "dest": "/web/dist/mockup-frames/$1",
      "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/api/cron/fb-scrape", "dest": "/api/cron/fb-scrape.ts" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ],
  "crons": [
    { "path": "/api/cron/fb-scrape", "schedule": "0 18 * * *" }
  ]
}
