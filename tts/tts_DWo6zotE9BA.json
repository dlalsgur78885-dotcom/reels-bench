{
  "tts_script": [
    {
      "start": "0",
      "end": "2.5",
      "direction": "차분하게",
      "text": "스무살 중고 명품샵 대표의 브이로그 시작해볼게요."
    },
    {
      "start": "4.8",
      "end": "6.7",
      "direction": "가볍게 질문하듯",
      "text": "당근 마켓 보면서 밥 먹냐고요?"
    },
    {
      "start": "7.3",
      "end": "10.0",
      "direction": "크게 소리치며",
      "text": "맞아요! 자는 동안 올라온 물건들 보고 있어요!"
    },
    {
      "start": "11.7",
      "end": "12.5",
      "direction": "차분하게",
      "text": "걸어서 출근해요."
    },
    {
      "start": "13.8",
      "end": "14.8",
      "direction": "차분하게",
      "text": "헬스장으로 출근해요."
    },
    {
      "start": "15.6",
      "end": "16.9",
      "direction": "차분하게",
      "text": "매일 운동 끝나고 일하러 가요."
    },
    {
      "start": "18.4",
      "end": "19.8",
      "direction": "차분하게",
      "text": "이제 진짜 출근해볼 거예요."
    },
    {
      "start": "22.5",
      "end": "23.7",
      "direction": "빠르게",
      "text": "출근길에 매입하러 가요."
    },
    {
      "start": "24.8",
      "end": "26.0",
      "direction": "빠르게",
      "text": "30분 동안 운전해야 해요."
    },
    {
      "start": "26.1",
      "end": "27.5",
      "direction": "빠르게",
      "text": "부산이라면 매입하러 직접 가요."
    },
    {
      "start": "28.5",
      "end": "30.0",
      "direction": "놀라며 소리치듯",
      "text": "샤갈! 이거 뭐예요?"
    },
    {
      "start": "30",
      "end": "33.9",
      "direction": "차분하게",
      "text": "2부로 돌아올게요. 팔로우하고 조금만 기다려주세요."
    }
  ]
}